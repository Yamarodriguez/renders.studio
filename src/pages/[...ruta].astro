---
/**
 * Genera las 145 paginas de la web.
 *
 * La direccion de cada una es la misma que en WordPress: /madrid/, /precios/,
 * /aviso-legal/... y la portada en /. Ni una sola URL cambia.
 *
 * El HTML lo monta scripts/lib/construir-pagina.mjs: cabecera y armazon
 * copiados de la web real, contenido generado desde el arbol de Elementor.
 */
import { creaConstructor } from '../../scripts/lib/construir-pagina.mjs';

export async function getStaticPaths() {
  const { paginas, nuevas } = creaConstructor(process.cwd());
  return [
    ...paginas.map((p) => ({
      // la portada va en la raiz; el resto, en su slug
      params: { ruta: p.slug === 'renders' ? undefined : p.slug },
      props: { slug: p.slug },
    })),
    // las guias nuevas del rediseno (datos/nuevas/)
    ...nuevas.map((slug) => ({ params: { ruta: slug }, props: { slug, nueva: true } })),
  ];
}

const { slug, nueva } = Astro.props;
const { construye, construyeNueva } = creaConstructor(process.cwd());
const html = nueva ? construyeNueva(slug) : construye(slug);
---

<Fragment set:html={html} />
